<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- عنوان برنامه -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:text="Shield Guard Antivirus"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- متن وضعیت اسکن -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="آماده برای اسکن دستگاه"
        android:textColor="#B0BEC5"
        android:textSize="14sp" />

    <!-- درصد پیشرفت -->
    <TextView
        android:id="@+id/percentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:text="0%"
        android:textColor="#4CAF50"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- نوار پیشرفت (Progress Bar) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:visibility="gone" />

    <!-- دکمه اسکن برنامه‌ها -->
    <Button
        android:id="@+id/btnScanApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#1E88E5"
        android:padding="12dp"
        android:text="اسکن سریع برنامه‌ها"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- دکمه اسکن عمیق فایل‌ها -->
    <Button
        android:id="@+id/btnScanFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#43A047"
        android:padding="12dp"
        android:text="اسکن عمیق فایل‌ها و حافظه"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- دکمه پاک‌سازی حافظه پنهان (Cache Cleaner) -->
    <Button
        android:id="@+id/btnCleanCache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#FB8C00"
        android:padding="12dp"
        android:text="پاک‌سازی حافظه پنهان (Cache)"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- لیست نمایش نتایج اسکن -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>
